{
  "name": "interactive-solar-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 30001",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 30000",
    "test:constellation-graph": "node --experimental-strip-types scripts/constellation-graph-consistency.mjs",
    "test:route-geometry": "node --experimental-strip-types scripts/route-geometry-validation.mjs",
    "test:route-sketch": "node --experimental-strip-types scripts/route-sketch-consistency.mjs",
    "test:target-projection": "node --experimental-strip-types scripts/target-aligned-projection-consistency.mjs",
    "test:route-directions": "node --experimental-strip-types scripts/route-object-directions.mjs",
    "test:route-selection": "node --experimental-strip-types scripts/route-selection-logic.mjs",
    "test:moon-catalogue": "node scripts/natural-moon-filter-validation.mjs"
  },
  "dependencies": {
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
